rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.rol == 'admin';
    }

    // Un pedido es válido solo si el producto existe, está activo y el precio/total coinciden
    // con el precio real guardado en Firestore (el cliente no puede inventar el importe).
    function precioValido(d) {
      let p = get(/databases/$(database)/documents/productos/$(d.productoId)).data;
      return p.activo == true
        && d.precioUnitario == p.precio
        && d.productoNombre == p.nombre
        && math.abs(d.total - p.precio * d.cantidad) < 0.01;
    }

    match /usuarios/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.rol == 'cliente'
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 2
        && request.resource.data.nombre.size() <= 60
        && request.resource.data.keys().hasOnly(['nombre','email','rol','creadoEn']);
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update: if isAdmin()
        || (signedIn() && request.auth.uid == uid
          && request.resource.data.rol == resource.data.rol
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nombre','email']));
      allow delete: if isAdmin();
    }

    match /productos/{productoId} {
      allow read: if resource.data.activo == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.nombre is string
        && request.resource.data.precio is number
        && request.resource.data.precio > 0
        && request.resource.data.activo is bool;
      allow update, delete: if isAdmin();
    }

    // Formulario de contacto: cualquier visitante puede enviar una consulta (con campos validados);
    // solo el administrador puede leerla, marcarla como leída o eliminarla.
    match /consultas/{consultaId} {
      allow create: if request.resource.data.keys().hasOnly(['nombre','telefono','correo','motivo',
             'fecha','hora','cantidad','sucursal','mensaje','leida','creadoEn'])
        && request.resource.data.nombre is string
        && request.resource.data.nombre.size() >= 3 && request.resource.data.nombre.size() <= 60
        && request.resource.data.telefono is string
        && request.resource.data.telefono.matches('^[267][0-9]{3}-?[0-9]{4}$')
        && request.resource.data.correo is string && request.resource.data.correo.size() <= 100
        && request.resource.data.motivo in ['pedido','evento','panetones','tarta','consulta']
        && request.resource.data.fecha is string && request.resource.data.fecha.size() <= 10
        && request.resource.data.hora is string && request.resource.data.hora.size() <= 5
        && (request.resource.data.cantidad == null
            || (request.resource.data.cantidad is int
                && request.resource.data.cantidad >= 1 && request.resource.data.cantidad <= 300))
        && request.resource.data.sucursal in ['','merliot','la-sultana']
        && request.resource.data.mensaje is string
        && request.resource.data.mensaje.size() >= 10 && request.resource.data.mensaje.size() <= 500
        && request.resource.data.leida == false
        && request.resource.data.creadoEn == request.time;
      allow read, delete: if isAdmin();
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leida']);
    }

    match /pedidos/{pedidoId} {
      allow create: if signedIn()
        && request.resource.data.usuarioId == request.auth.uid
        && request.resource.data.estado == 'Pendiente'
        && request.resource.data.cantidad is int
        && request.resource.data.cantidad >= 1
        && request.resource.data.cantidad <= 30
        && request.resource.data.total is number
        && request.resource.data.total > 0
        && request.resource.data.productoId is string
        && request.resource.data.productoNombre is string
        && request.resource.data.sucursal in ['Merliot','La Sultana']
        && request.resource.data.keys().hasOnly(['usuarioId','cliente','productoId','productoNombre',
             'precioUnitario','cantidad','total','sucursal','fecha','hora','nota','estado','creadoEn'])
        && request.resource.data.creadoEn == request.time
        && precioValido(request.resource.data);
      allow read: if signedIn() && (resource.data.usuarioId == request.auth.uid || isAdmin());
      allow update: if isAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','actualizadoEn'])
        && request.resource.data.estado in ['Pendiente','Preparando','Listo','Entregado','Cancelado'];
      allow delete: if isAdmin();
    }
  }
}